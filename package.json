{
  "name": "brief",
  "private": true,
  "version": "1.0.0",
  "description": "Brief financial news intelligence platform",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "python -m pip install -r backend/requirements.txt"
  }
}

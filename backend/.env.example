# FastAPI
ENVIRONMENT=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=brief

# Redis Cloud: copy the complete public URL from the Redis console.
# It may use rediss:// for TLS and include a password.
REDIS_URL=rediss://default:<password>@<endpoint>:<port>

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# AI and session security
GROQ_API_KEY=your_groq_api_key
SESSION_SECRET=replace_with_a_long_random_secret
